# Copy this file to .env and fill in your own keys. Never commit .env.

# Backboard — single API key routing to open-weight models
# https://docs.backboard.io/authentication
BACKBOARD_API_KEY=
# Which provider/model Backboard should route to. Check your Backboard
# dashboard for the exact provider + open-weight model identifiers you have
# access to (e.g. a Groq- or Fireworks-hosted Llama/Qwen model).
BACKBOARD_LLM_PROVIDER=groq
BACKBOARD_MODEL_NAME=llama-3.3-70b-versatile

# ElevenLabs — text-to-speech for the spoken review
# https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Tinker (Thinking Machines) — used by the finetune/ scripts, not the Node app.
# https://tinker-docs.thinkingmachines.ai
TINKER_API_KEY=

# If set to a saved-weights path (from finetune/train.py), review.js will ask
# Backboard-routed inference to use style notes sampled from your fine-tuned
# checkpoint instead of the generic prompt. Leave blank to skip.
FINETUNED_STYLE_NOTES_FILE=
