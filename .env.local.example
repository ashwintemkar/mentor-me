# Copy to .env.local for local dev. In Vercel, add these under
# Project Settings -> Environment Variables instead. Never commit .env.local.

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google and GitHub sign-in are configured as providers inside the Supabase
# dashboard (Authentication -> Providers), not as env vars here.

# Backboard (backboard-sdk) — single API key routing to open-weight models
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openrouter
BACKBOARD_MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# ElevenLabs — text-to-speech for the spoken review
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: path (relative to project root) to a text file of style notes
# sampled from the Tinker-fine-tuned checkpoint (see finetune/compare.py)
FINETUNED_STYLE_NOTES_FILE=
